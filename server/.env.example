DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metaverso_upds
PORT=3001
JWT_SECRET=cambiar-en-produccion-2026

# --- WebRTC / canal de voz ---
# Sin TURN el audio SOLO funciona entre equipos de la misma red local.
# Para que funcione por el tunel (datos moviles + wifi, NAT simetrico) hace
# falta un TURN real. Opciones:
#   a) coturn propio:      turn:tu-servidor:3478,turns:tu-servidor:5349?transport=tcp
#   b) Metered (free tier): crear cuenta y usar las credenciales del panel
#   c) Cloudflare Realtime TURN
# Varias URLs separadas por coma. Incluye siempre una variante TCP/TLS en 443:
# es la unica que atraviesa firewalls institucionales restrictivos.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
